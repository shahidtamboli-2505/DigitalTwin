# ============================================================
# AI-Powered Digital Twin — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME=DigitalTwinSangli
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-string-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL (Neon) ───────────────────────────────────────
# Sign up: https://neon.tech
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/digital_twin?sslmode=require
DATABASE_POOL_SIZE=10

# ─── MongoDB Atlas ───────────────────────────────────────────
# Sign up: https://www.mongodb.com/cloud/atlas
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/digital_twin?retryWrites=true&w=majority
MONGODB_DB_NAME=digital_twin

# ─── Redis Cloud ─────────────────────────────────────────────
# Sign up: https://redis.io/try-free
REDIS_URL=redis://default:password@redis-xxxxx.c1.region.cloud.redislabs.com:port

# ─── Cloudinary (Image Storage) ──────────────────────────────
# Sign up: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email (Brevo SMTP) ─────────────────────────────────────
# Sign up: https://www.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-email
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=noreply@digitaltwin.com

# ─── Google Gemini API ───────────────────────────────────────
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Weather API ─────────────────────────────────────────────
# No API key needed — Open-Meteo is free
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ─── GIS APIs ────────────────────────────────────────────────
# No API keys needed — these are free
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api

# ─── CesiumJS ────────────────────────────────────────────────
# Sign up: https://ion.cesium.com/signup
CESIUM_ION_TOKEN=your-cesium-ion-token

# ─── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://default:password@redis-xxxxx:port/0
CELERY_RESULT_BACKEND=redis://default:password@redis-xxxxx:port/1
